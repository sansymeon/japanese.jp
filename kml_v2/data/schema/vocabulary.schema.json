{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese.jp/kml_v2/schema/vocabulary.schema.json",
  "title": "KML Lesson Vocabulary",
  "type": "object",
  "required": ["lesson_id", "items"],
  "properties": {
    "lesson_id": { "type": "string", "pattern": "^lesson_[0-9]{3}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "surface": { "type": "string" },
          "reading": { "type": ["string", "null"] },
          "meaning": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}
