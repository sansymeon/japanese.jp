{
  "schema_version": "2.0",
  "system_name": "kml_master_visual_system",
  "description": "Master visual orchestration system for KML kanji image generation. Separates emotional lesson identity from material execution strategy.",

  "core_principle": {
    "lesson_role": "Determines emotional atmosphere and environmental identity",
    "variant_role": "Determines physical material execution and visual application behavior",
    "hero_role": "Determines showcase-level artistic treatment for selected kanji"
  },

  "global_rules": {
    "kanji_integrity": [
      "Preserve kanji structure exactly",
      "Do not invent strokes",
      "Do not remove strokes",
      "Do not distort balance unless explicitly requested",
      "Material effects must respect kanji readability"
    ],

    "surface_philosophy": [
      "Paint should feel integrated into the surface",
      "Texture should feel physical rather than simulated",
      "Imperfection is welcomed when controlled",
      "No sterile digital appearance",
      "Every brush interaction should feel intentional"
    ],

    "rarity_behavior": {
      "common": 0.65,
      "uncommon": 0.22,
      "rare": 0.10,
      "legendary": 0.03
    }
  },

