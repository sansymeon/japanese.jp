# Netlify does not expose the git symlink kml/analytics/dashboard/data → ../output.
# Rewrite so legacy /dashboard/data/* URLs resolve to the real analytics JSON.
/kml/analytics/dashboard/data/*  /kml/analytics/output/:splat  200

# Museum phase: curriculum landing retired — Kanji Studies opens at the Bookshelf.
/kml/index.html  /kml/contents/books/  301
/kml/  /kml/contents/books/  301

# Beginners enter at the Room Map. Force 301 because start-here/index.html
# still exists on disk this release. Exact paths only — do not splat
# /start-here/* or /start-here/rooms/ would loop.
/start-here/index.html  /start-here/rooms/  301!
/start-here             /start-here/rooms/  301!

# 漢検への道 is Japanese-only at /kanken/. The old /ja/kanken/ pages are
# still on disk, so force. /kanken/ is outside /ja/kanken/, so no loop.
/ja/kanken    /kanken/         301!
/ja/kanken/*  /kanken/:splat   301!
