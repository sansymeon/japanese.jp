# NOTE:
# The Image Knowledge Base is intentionally tracked.
# Although initially generated, it currently contains manual editorial
# curation (visual reviews, masterpiece flags, mood, lighting, reuse
# notes, metadata confidence, etc.) that cannot yet be reproduced
# losslessly by the build pipeline.
#
# Reconsider only after build_image_knowledge_base.py supports
# complete round-trip reconstruction from source assets and
# visual_enrichment files.

# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
.venv/
.venv_*/
.env/

# System junk
.DS_Store
Thumbs.db

# Editor
.vscode/

# Logs
*.log

# Build/cache
dist/
build/
.cache/

# Temp
*.tmp
*.bak
*.bak.png
*.vertical.bak.png

# Ambient recording / QA junk (local only)
*.nohup.out
nohup.out
kml/tools/ambient/collections/**/.qa_*/
kml/tools/ambient/collections/**/.record_preview_*/
kml/tools/ambient/collections/**/.tmp_*/
kml/tools/ambient/collections/**/*_preview.json
kml/tools/ambient/collections/**/*_qa.json
kml/tools/ambient/collections/**/*_probe.json

# Ambient generated assets
kml/tools/ambient/assets/

# Ambient audio — keep locally (binary assets, not versioned)
kml/tools/ambient/audio/*.mp3
kml/tools/ambient/audio/*.aup3

# Self-hosted CJK serif OTFs (~96MB) — fetch via scripts/fetch_noto_serif_jp_fonts.sh
kml/tools/ambient/fonts/noto-serif-jp/*.otf
kml/tools/ambient/fonts/yuji-syuku/*.ttf
kml/tools/ambient/fonts/yuji-syuku/*.otf

# Audacity project files (often very large)
*.aup3
*.aup3-shm
*.aup3-wal

# Video exports
*.mp4
*.mov
*_original.mp4

# Render folders
captures/
exports/
thumbnails/
kml/tools/ambient/study_exhibitions/
kml/tools/ambient/heart_exhibitions/
kml/tools/ambient/archive_for_removal/
kml/tools/ambient/extended_exhibitions/
kml/tools/ambient/.playwright-browsers/
kml/tools/ambient/gallery_guardian_samples/
kml/tools/ambient/typography_samples/
kml/tools/ambient/mobile_verse_samples/
kml/tools/ambient/collections/prototypes/stills/
kml/tools/ambient/.venv/

# YouTube / export assets (local only)
assets/youtube/

# Evaluation / experimental image generations (regenerable)
assets/images/lesson_01_kml_v*_test/

# Ambient QA / capture stills
kml/tools/ambient/analysis_frames/

# Image-pipeline intermediate masks and local outputs
kml/data/kanji/masks/
kml/data/kanji/outputs/

# KML V2 large media (metadata references only)
kml_v2/media/

# PNG masters — web delivery uses production assets elsewhere
kml/assets/covers_png/
kml/assets/studies_png/
kml/assets/images_png/
kml/assets/youtube_thumbnails_png/
start-here/assets/images_png/

# Local visual-review / conversion tests
_png_review/
_jpeg_q90_visual_test/

# Alternative Start Here: YouTube doorway + static-study sheet (not the live path)
start-here-youtube-doorway-prototype/

# Local tooling scratch
kml/tools/tmp/

# Ambient throwaway captures
kml/tools/ambient/collections/**/.timing_probe*/
kml/tools/ambient/collections/**/.preview/

# Generated contact-sheet output
kml/tools/ambient/collections/**/contact_sheets/*.jpg
